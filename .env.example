# Postgres (Neon / Supabase / local)
DATABASE_URL=postgres://user:password@localhost:5432/affiliate

# Password untuk login /admin
ADMIN_PASSWORD=tukar-password-ni

# Rahsia untuk sign cookie session. Jana: openssl rand -base64 32
AUTH_SECRET=

# Cloudflare R2 (untuk upload logo/favicon)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (untuk magic link auth)
RESEND_API_KEY=
OWNER_EMAIL=
